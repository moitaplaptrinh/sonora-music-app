def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    p = Path(arg) if arg else next((q for q in (Path('index.html'), Path('SONORA2.html')) if q.is_file()), None)
    if not p or not p.is_file():
        print('Khong thay index.html. Chay: python apply_v6.py duong_dan/index.html'); sys.exit(1)
    s = p.read_bytes().decode('utf-8')
    if 'id="sonora-v6"' in s:
        print('Da va v6 truoc do, bo qua.'); return
    i = s.rfind('</body>')
    if i < 0:
        print('Khong tim thay </body> - file khong dung.'); sys.exit(2)
    shutil.copy2(p, p.with_name(p.name + '.bak'))
    add = '<style id="sonora-v6">' + CSS + '</style>\n<script id="sonora-v6-js">' + JS + '</script>\n'
    p.write_bytes((s[:i] + add + s[i:]).encode('utf-8'))
    print('Da va', p, '(backup:', p.name + '.bak). Khoi dong lai server, Ctrl+F5 tren trinh duyet.')


if __name__ == '__main__':
    main()
