def patch(path, items):
    s = path.read_bytes().decode('utf-8')
    if MARK in s: print('  - da va truoc do:', path.name); return
    bad = []
    for i, (old, new) in enumerate(items, 1):
        c = s.count(old)
        if c != 1: bad.append((i, c, old[:70])); continue
        s = s.replace(old, new, 1)
    if bad:
        print('  ! KHONG ghi', path.name, '- diem va khong khop:')
        for i, c, o in bad: print('     #%d x%d %s' % (i, c, o))
        return
    shutil.copy2(path, path.with_name(path.name + '.bak'))
    path.write_bytes(s.encode('utf-8'))
    print('  + da va %d diem: %s (backup .bak)' % (len(items), path.name))

