#!/usr/bin/env python3
"""SONORA mobile v1 - bien SONORA thanh app cai duoc tren dien thoai (PWA) va san sang dong goi APK.
Dat file nay cung thu muc voi server.py (hoac sever.py) + index.html, roi chay:  python apply_mobile.py
Script se:
  1. Tao manifest.webmanifest, sw.js, icon-192.png, icon-512.png, icon-maskable-512.png (khong can cai them thu vien)
  2. Va server.py  -> them route phuc vu cac file tren + /.well-known/assetlinks.json
  3. Va index.html -> them the manifest/theme-color, dang ky service worker, vai dong CSS cho cam ung
Moi file duoc backup thanh *.bak. Neu 1 diem va khong khop, file do KHONG bi ghi (an toan). Chay lai nhieu lan van an toan."""
import json, re, shutil, struct, zlib
from pathlib import Path

MARK = 'sonora-mobile-v1'
here = Path(__file__).resolve().parent

# ---------------------------------------------------------------- assets
MANIFEST = {
    "id": "/",
    "name": "SONORA",
    "short_name": "SONORA",
    "description": "SONORA - nghe, dang va chia se nhac.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#050505",
    "theme_color": "#050505",
    "categories": ["music", "entertainment"],
    "icons": [
        {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
        {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
        {"src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
    ],
}

SW_JS = r'''// sonora-mobile-v1
// Service worker toi gian: chi cache "vo" ung dung de mo nhanh / mo khi mat mang.
// KHONG dung vao /api/*, audio stream hay /uploads/* (nhac luon di thang len server).
const V = 'sonora-shell-v1';
const SHELL = ['/', '/icon-192.png', '/icon-512.png', '/manifest.webmanifest'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(V).then(c => c.addAll(SHELL)).catch(() => {}));
  self.skipWaiting();
});

self.addEventListener('activate', e => {
  e.waitUntil(
    caches.keys()
      .then(keys => Promise.all(keys.filter(k => k !== V).map(k => caches.delete(k))))
      .then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', e => {
  const r = e.request;
  if (r.method !== 'GET') return;
  const u = new URL(r.url);
  if (u.origin !== location.origin) return;

  // Trang chinh: uu tien ban moi tu server, mat mang thi dung ban da luu
  if (r.mode === 'navigate' && (u.pathname === '/' || u.pathname === '/index.html')) {
    e.respondWith(
      fetch(r).then(res => {
        if (res.ok && res.type === 'basic' && !res.redirected) {
          const copy = res.clone();
          caches.open(V).then(c => c.put('/', copy)).catch(() => {});
        }
        return res;
      }).catch(() => caches.match('/'))
    );
    return;
  }

  // Icon + manifest: cache-first
  if (/^\/icon-.*\.png$/.test(u.pathname) || u.pathname === '/manifest.webmanifest') {
    e.respondWith(caches.match(r).then(h => h || fetch(r)));
  }
});
'''


# ---------------------------------------------------------------- icon generator (pure python PNG)
def _png(w, h, rgba):
    def chunk(t, d):
        c = struct.pack('>I', len(d)) + t + d
        return c + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        raw += rgba[y * w * 4:(y + 1) * w * 4]
    return (b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 6, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(bytes(raw), 9)) + chunk(b'IEND', b''))


def make_icon(size, maskable):
    """Nen den, 5 thanh equalizer trang (giong logo SONORA). maskable: nen tran vien, logo nho lai cho vao vung an toan."""
    bg = (5, 5, 5)
    fg = (244, 244, 242)
    # chieu cao tuong doi cua 5 thanh (theo logo): 6, 14, 18, 10, 14
    heights = [6, 14, 18, 10, 14]
    scale = 0.50 if maskable else 0.56            # logo chiem bao nhieu phan icon
    total_h = size * scale
    unit = total_h / 18.0
    bw = unit * 2.4 * 1.5                          # be rong thanh
    gap = unit * 2.5 * 1.5 - bw + unit * 0.6
    total_w = bw * 5 + gap * 4
    x0 = (size - total_w) / 2
    cy = size / 2
    bars = []
    for i, hh in enumerate(heights):
        bx0 = x0 + i * (bw + gap)
        bh = hh * unit
        bars.append((bx0, cy - bh / 2, bx0 + bw, cy + bh / 2, bw / 2))
    corner = 0 if maskable else size * 0.22
    ss = 2                                         # sieu lay mau 2x2 cho muot canh
    buf = bytearray(size * size * 4)
    n = ss * ss

    def in_bar(px, py):
        for (a, b, c, d, r) in bars:
            if px < a or px > c or py < b or py > d: continue
            qx = min(max(px, a + r), c - r)
            qy = min(max(py, b + r), d - r)
            if (px - qx) ** 2 + (py - qy) ** 2 <= r * r: return True
        return False

    def in_round(px, py):
        if corner == 0: return True
        qx = min(max(px, corner), size - corner)
        qy = min(max(py, corner), size - corner)
        return (px - qx) ** 2 + (py - qy) ** 2 <= corner * corner

    for y in range(size):
        for x in range(size):
            cov_bg = cov_fg = 0
            for sy in range(ss):
                for sx in range(ss):
                    px = x + (sx + .5) / ss
                    py = y + (sy + .5) / ss
                    if in_round(px, py):
                        cov_bg += 1
                        if in_bar(px, py): cov_fg += 1
            i = (y * size + x) * 4
            if cov_bg == 0:
                continue                           # trong suot
            f = cov_fg / cov_bg
            buf[i] = round(bg[0] + (fg[0] - bg[0]) * f)
            buf[i + 1] = round(bg[1] + (fg[1] - bg[1]) * f)
            buf[i + 2] = round(bg[2] + (fg[2] - bg[2]) * f)
            buf[i + 3] = round(255 * cov_bg / n)
    return _png(size, size, buf)


def write_assets():
    (here / 'manifest.webmanifest').write_text(json.dumps(MANIFEST, indent=2, ensure_ascii=False), encoding='utf-8')
    (here / 'sw.js').write_text(SW_JS, encoding='utf-8')
    for name, size, mk in (('icon-192.png', 192, False), ('icon-512.png', 512, False), ('icon-maskable-512.png', 512, True)):
        (here / name).write_bytes(make_icon(size, mk))
    (here / '.well-known').mkdir(exist_ok=True)
    print('  + da tao: manifest.webmanifest, sw.js, icon-192.png, icon-512.png, icon-maskable-512.png')


# ---------------------------------------------------------------- patches
