FROM python:3.12-slim
WORKDIR /app
COPY server.py index.html ./
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOST=0.0.0.0 PORT=8787 SONORA_DATA_DIR=/var/data
EXPOSE 8787
VOLUME ["/var/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8787')+'/api/health',timeout=4)"
CMD ["python", "server.py"]
